# Ethereum mainnet deploy config — template
#
# Copy to `.env.ethereum-mainnet` (untracked) and fill in.
# `scripts/deploy-with-validation.js` loads `.env`, then `.env.local`, then
# `.env.<network>` with override, so values here win for `npm run deploy:mainnet`.
#
# BUT: `hardhat.config.ts` re-loads `.env.local` with override inside the spawned
# `hardhat deploy` process, so a key present in `.env.local` (even an empty `KEY=`)
# beats the value set here. Keep the deploy flags out of `.env.local`.
#
# This spends real ETH. Read docs/DEPLOYMENT.md before running.

# Deployer wallet (required)
PRIVATE_KEY=

# Optional: override the AstaVerde owner. Leave empty to deploy as the deployer,
# then transferOwnership to the final owner and read owner() back to confirm.
OWNER_ADDRESS=

# RPC (recommended: a direct URL; otherwise RPC_API_KEY is used with Alchemy)
ETHEREUM_MAINNET_RPC_URL=
RPC_API_KEY=

# Etherscan V2: one key covers mainnet and Sepolia
ETHERSCAN_API_KEY=

# Deployment flags
# Vault (SCC + EcoStabilizer) is opt-in on a production network.
DEPLOY_VAULT_V2=true
# Fresh marketplace deploy. Set true + AV_ADDR to reuse an existing AstaVerde instead.
USE_EXISTING_ASTAVERDE=false
AV_ADDR=

# Irreversible: renouncing SCC DEFAULT_ADMIN_ROLE cannot be undone.
# Set true only on the owner's explicit decision.
RENOUNCE_SCC_ADMIN=false

# Confirmations to wait for after each deploy transaction (default 1).
# 2 is safer on L1, where the SCC grantRole receipt gates the next read.
DEPLOY_WAIT_CONFIRMATIONS=2

# Mainnet tip bounds in gwei (defaults 0.1 and 1). The deploy script pays 120% of
# the RPC's suggested tip, clamped to this range. Leave empty for the defaults.
DEPLOY_MIN_PRIORITY_FEE_GWEI=
DEPLOY_MAX_PRIORITY_FEE_GWEI=

# USDC: leave empty to use Circle USDC 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# from the native-USDC map in deploy/deploy.ts. Set only to override.
USDC_ADDRESS=
