# Ethereum Sepolia deploy config — template
#
# Copy to `.env.ethereum-sepolia` (untracked) and fill in.
# `scripts/deploy-with-validation.js` loads `.env`, then `.env.local`, then
# `.env.<network>` with override, so values here win for `npm run deploy:testnet`.
#
# Note: helper scripts run outside the deploy wrapper (e.g. `npm run mint:testnet`)
# read only `.env` and `.env.local`. Keep PRIVATE_KEY / RPC there too if you use them.

# Deployer wallet (required)
PRIVATE_KEY=

# Optional: override the AstaVerde owner. Leave empty to deploy as the deployer,
# then hand over later with transferOwnership.
OWNER_ADDRESS=

# RPC (recommended: a direct URL; otherwise RPC_API_KEY is used with Alchemy)
ETHEREUM_SEPOLIA_RPC_URL=
RPC_API_KEY=

# Etherscan V2: one key covers Sepolia and mainnet
ETHERSCAN_API_KEY=

# Deployment flags
# Sepolia is a test network: the vault (SCC + EcoStabilizer) is deployed
# automatically regardless of this flag, because the network name contains "sepolia".
DEPLOY_VAULT_V2=true
USE_EXISTING_ASTAVERDE=false
AV_ADDR=

# Ignored on Sepolia: the deploy script never renounces SCC admin on a "sepolia" network.
RENOUNCE_SCC_ADMIN=false

# Confirmations to wait for after each deploy transaction (default 1).
DEPLOY_WAIT_CONFIRMATIONS=1

# USDC: leave empty. Chain 11155111 is in `mockSupportedChainIds`, so
# deploy/deploy.ts deploys MockUSDC automatically and uses its address.
USDC_ADDRESS=

# Optional: used by the mint helper (`npm run mint:testnet`)
PINATA_JWT=
