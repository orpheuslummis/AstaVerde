# AstaVerde webapp environment (untracked)
# Copy to webapp/.env.local and fill in your values.
#
# Start the dev server from webapp/:
#   npm run dev
#
# Note: the root `npm run dev:sepolia` helper still expects
# NEXT_PUBLIC_CHAIN_SELECTION=arbitrum_sepolia and will refuse this config.

# Network selection
NEXT_PUBLIC_CHAIN_SELECTION=ethereum_sepolia

# Contract addresses (Ethereum Sepolia)
NEXT_PUBLIC_ASTAVERDE_ADDRESS=0x0000000000000000000000000000000000000000
# Canonical Circle USDC on Ethereum Sepolia
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Phase 2 vault (optional for vault UI)
NEXT_PUBLIC_ECOSTABILIZER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SCC_ADDRESS=0x0000000000000000000000000000000000000000

# RPC (choose one)
# Recommended: set the full HTTPS RPC URL you want the browser to use.
NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=
# Optional fallback: if NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL is not set, the app uses
# https://eth-sepolia.g.alchemy.com/v2/${NEXT_PUBLIC_ALCHEMY_API_KEY}
NEXT_PUBLIC_ALCHEMY_API_KEY=

# WalletConnect (optional; if blank, only Injected connector is enabled)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# IPFS
# Path-style gateway of the storage provider that pins the token files (Pinata
# dedicated gateway, e.g. https://<name>.mypinata.cloud/ipfs/). Optional fallback.
NEXT_PUBLIC_IPFS_GATEWAY_URL=
NEXT_PUBLIC_IPFS_FALLBACK_GATEWAY_URL=
# Server-side only (never NEXT_PUBLIC_): Pinata scoped key with "Files: write".
# The admin mint page uploads through /api/ipfs/upload-url, which checks that the
# connected wallet is the contract owner (or a signer of the owner Safe).
PINATA_JWT=

# USDC config
NEXT_PUBLIC_USDC_DECIMALS=6

# ---- Production (Vercel) — Ethereum mainnet ----
# Set these in the Vercel dashboard (do not commit a file):
#
# NEXT_PUBLIC_CHAIN_SELECTION=ethereum_mainnet
# Canonical Circle USDC on Ethereum mainnet
# NEXT_PUBLIC_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# NEXT_PUBLIC_ASTAVERDE_ADDRESS=0x...
# NEXT_PUBLIC_ECOSTABILIZER_ADDRESS=0x...
# NEXT_PUBLIC_SCC_ADDRESS=0x...
# NEXT_PUBLIC_ETHEREUM_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key
# NEXT_PUBLIC_ALCHEMY_API_KEY=   # optional if MAINNET_RPC_URL is set
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# NEXT_PUBLIC_IPFS_GATEWAY_URL=https://<name>.mypinata.cloud/ipfs/
# PINATA_JWT=   (server-side, "Files: write" scope)
# NEXT_PUBLIC_USDC_DECIMALS=6
