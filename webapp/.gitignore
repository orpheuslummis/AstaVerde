# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies

/node_modules
/.pnp
.pnp.js

# testing

/coverage
/e2e-reports
/test-results
/e2e/.env
/e2e/screenshots
/e2e/videos
/playwright-report
/playwright/.cache
/.cache/synpress

# next.js

/.next/
/out/

# production

/build

# misc

.DS_Store
\*.pem

# local dev outputs
dev-*.out

# debug

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel

.vercel

# typescript

\*.tsbuildinfo
next-env.d.ts

# The repo-root .gitignore has a bare "types" pattern (for the root typechain
# output), which also swallows any directory named types under webapp/. Keep the
# shared type modules tracked.
!src/shared/types/
