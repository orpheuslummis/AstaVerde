# Root secrets (do NOT commit your real `.env.local`)
#
# Used by Hardhat + deployment scripts.

# Deployer wallet (required for deploys)
PRIVATE_KEY=

# Optional: override the AstaVerde owner (if omitted, deployer is used)
OWNER_ADDRESS=

# Optional: mnemonic used for local Hardhat/dev-only flows
MNEMONIC=test test test test test test test test test test test junk

# RPC configuration (choose one approach)
#
# Recommended: set direct RPC URLs to avoid rate limits.
ETHEREUM_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
ETHEREUM_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key
#
# Previous target (Arbitrum One is still deployed; `npm run deploy:arbitrum-*`)
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your_alchemy_key
ARBITRUM_MAINNET_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_alchemy_key
#
# Optional fallback: if direct URLs are not set, Hardhat uses Alchemy via:
RPC_API_KEY=

# Explorer verification (optional)
# Ethereum: Etherscan V2 uses a single key for both mainnet and Sepolia.
ETHERSCAN_API_KEY=
# Arbitrum keeps its own per-chain keys.
ARBITRUM_SEPOLIA_EXPLORER_API_KEY=
ARBITRUM_MAINNET_EXPLORER_API_KEY=

# Deployment flags — set these in `.env.<network>` (e.g. `.env.ethereum-mainnet`), not here.
#
# PRECEDENCE WARNING: `hardhat.config.ts` re-loads `.env.local` with override inside the
# child process that `scripts/deploy-with-validation.js` spawns. So any key present in this
# file — including an empty `KEY=`, which parses as "" — overwrites the per-network value the
# wrapper had just applied. Leave them commented out unless you really want them everywhere.
#
# DEPLOY_VAULT_V2=false
# USE_EXISTING_ASTAVERDE=false
# AV_ADDR=
# RENOUNCE_SCC_ADMIN=false
# DEPLOY_WAIT_CONFIRMATIONS=1
# USDC_ADDRESS=

# Optional: used by mint helper (`npm run mint:testnet`)
PINATA_JWT=
